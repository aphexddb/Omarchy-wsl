# Normalize line endings so Linux-bound files are always LF in the repo,
# regardless of the contributor's OS. The Dockerfile also strips CR at build
# time, so this is belt-and-suspenders for a clean cross-platform checkout.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf

# Files that run inside the Linux image must be LF.
*.sh        text eol=lf
*.packages  text eol=lf
*.conf      text eol=lf
*.json      text eol=lf

# Binary assets — never normalize.
*.wsl  binary
*.tar  binary
*.png  binary
*.ico  binary
*.svg  binary
