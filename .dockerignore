# Keep the build context lean and reproducible.
# NOTE: omarchy/.git is intentionally NOT ignored — the Dockerfile regenerates
# the working tree from git blobs to fix Windows CRLF/exec-bit issues, and
# keeping .git lets `omarchy update` work inside the distro.

